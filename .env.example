# ---- fal.ai (obrigatório) ----
# Crie em https://fal.ai/dashboard/keys
FAL_KEY=

# Endpoints do MiniMax H3 Max Turbo no fal.ai
FAL_MODEL_T2V=minimax/h3-max-turbo/text-to-video
FAL_MODEL_I2V=minimax/h3-max-turbo/image-to-video
# 480P | 768P | 1080P
FAL_RESOLUTION=480P
# disabled | balanced | quality  (disabled preserva exatamente o prompt + estilo injetado)
FAL_PROMPT_EXPANSION=disabled

# Preço por segundo de vídeo gerado (USD) — confira em fal.ai/models/minimax/h3-max-turbo
# Tabela padrão a partir de 16/11/2026: 480P = 0.025 | 768P = 0.04 | 1080P = 0.08
COST_PER_SECOND=0.025

# Duração de cada cena (segundos) e velocidade de fala usada na divisão do roteiro
SCENE_SECONDS=10
WORDS_PER_MINUTE=140
MAX_SCENES=400

# ---- API de texto (obrigatório) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ---- Servidor ----
PORT=3333
