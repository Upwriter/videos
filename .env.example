# Na Vercel: cadastre estas variáveis em Project → Settings → Environment Variables.
# Localmente: copie para .env e rode `npm start`.

# ---- Proteção (OBRIGATÓRIO na Vercel) ----
# Senha pedida na tela de entrada. Sem ela, qualquer pessoa com o link gastaria seus créditos.
APP_PASSWORD=

# ---- fal.ai (obrigatório) ----
FAL_KEY=
FAL_MODEL_T2V=minimax/h3-max-turbo/text-to-video
FAL_MODEL_I2V=minimax/h3-max-turbo/image-to-video
# 480P | 768P | 1080P
FAL_RESOLUTION=480P
# disabled | balanced | quality  (disabled preserva exatamente o prompt + estilo injetado)
FAL_PROMPT_EXPANSION=disabled

# Preço por segundo (USD). Tabela padrão a partir de 16/11/2026: 480P = 0.025 | 768P = 0.04 | 1080P = 0.08
COST_PER_SECOND=0.025

# Imagens estáticas (modos "Misto" e "Tudo em imagem")
# texto→imagem (sem referência) e imagem→imagem (mantém personagem/produto/cenário da referência)
IMAGE_T2I_MODEL=fal-ai/flux-2-flex
IMAGE_T2I_COST=0.05
IMAGE_I2I_MODEL=fal-ai/flux-pro/kontext
IMAGE_I2I_COST=0.04

SCENE_SECONDS=10
WORDS_PER_MINUTE=140
MAX_SCENES=400

# ---- API de texto (obrigatório) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Raciocínio do modelo: vazio = automático (minimal no gpt-5-mini, mais rápido). minimal | low | medium | high | off
OPENAI_REASONING_EFFORT=
# Tempo máximo de cada chamada à IA (ms) — fica abaixo dos 60 s da função da Vercel
OPENAI_TIMEOUT_MS=50000

# ---- Só local ----
PORT=3333
